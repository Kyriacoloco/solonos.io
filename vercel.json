{
  "rewrites": [
    {
      "source": "/((?!ConsortiaValuationBuilder\\.html$|Buyer-Discount-Scorecard\\.pdf$|sw\\.js$|manifest\\.json$|icon-192\\.png$|icon-512\\.png$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/ConsortiaValuationBuilder.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}